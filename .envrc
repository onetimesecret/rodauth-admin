# .envrc
#
# direnv loads this automatically when you cd into the checkout.
# First time here: run bin/setup (bundle install + git hooks).

source_up_if_exists

# Explicit watch list: dotenv_if_exists also watches, but only the files the
# active branch touches. Watching all of them (existing or not) means edits —
# including through the .env symlink — and file creation both trigger a reload.
watch_file .env .env.local

dotenv_if_exists

# .env.local overrides happen last if the file exists.
#
# Because each dotenv call just exports variables into the same sub-shell, the
# order you write them determines precedence — later calls override earlier
# ones. So .env.local values win over .env values in the above setup.
dotenv_if_exists .env.local

# RACK_ENV is owned by this file, not by .env — and it is exported AFTER both
# dotenv calls so it wins over anything they set. A stray `RACK_ENV=test` line
# in .env would otherwise turn every shell in this checkout into a "provisioned
# test run": bin/ci and spec/support/spec_mode.rb both treat RACK_ENV=test plus
# a set ADMIN_DATABASE_URL as "a database was provisioned for this run", and the
# URL here is your real local authdb. The spec suite truncates account tables.
# Production sets RACK_ENV in the process environment; direnv is not involved.
export RACK_ENV=development

# Note that this shell is deliberately NOT a test environment: RACK_ENV stays
# development and ADMIN_DATABASE_URL points at your real local authdb. The
# spec suite ignores both and builds its own scratch SQLite (see
# spec/support/spec_mode.rb), so `bin/ci` is safe to run from here.
