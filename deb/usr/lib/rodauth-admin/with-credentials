#!/bin/sh
#
# with-credentials - export a directory of secret files as environment
#                    variables, then exec a command.
#
# Usage: with-credentials COMMAND [ARG...]
#
# Reads $CREDENTIALS_DIRECTORY: every regular file in it becomes an
# environment variable named after the file, holding the file's contents.
# Nothing here is Debian- or systemd-specific beyond the variable name;
# any directory of secret files works, e.g.
#
#   CREDENTIALS_DIRECTORY=/run/secrets with-credentials ./server
#
# Under systemd the directory is provided by LoadCredential= /
# LoadCredentialEncrypted= (systemd.exec(5), "Credentials"), mode 0700 and
# readable only by the service user.
#
# Two properties the callers rely on:
#   - "$(cat file)" strips trailing newlines, so a value sealed with
#     `printf '%s'` round-trips exactly and one sealed with a here-string
#     loses its newline. Documented in rodauth-admin(8) NOTES.
#   - exec, so the PID is preserved for Type=notify and for signals.
#
# The trade-off: the values land in the process environment, hence in
# /proc/<pid>/environ, readable by the process owner and root only. That
# is the price of keeping the application env-var-only, and is still
# better than EnvironmentFile= (nothing in cleartext on disk, and
# `systemctl show` reveals nothing).
#
# Exit 78 (EX_CONFIG) on any configuration problem: no secrets, no run.

set -eu

if [ "$#" -eq 0 ]; then
  echo "with-credentials: usage: with-credentials COMMAND [ARG...]" >&2
  exit 64
fi

if [ -z "${CREDENTIALS_DIRECTORY:-}" ]; then
  echo "with-credentials: CREDENTIALS_DIRECTORY is unset or empty" >&2
  exit 78
fi

if [ ! -d "$CREDENTIALS_DIRECTORY" ]; then
  echo "with-credentials: $CREDENTIALS_DIRECTORY is not a directory" >&2
  exit 78
fi

for cred in "$CREDENTIALS_DIRECTORY"/*; do
  # An empty directory leaves the glob unexpanded; skip anything that is
  # not a plain file (subdirectories, sockets).
  [ -f "$cred" ] || continue
  name=${cred##*/}
  # A credential id that is not a valid shell/C identifier cannot be
  # exported, and silently skipping it would start the app without a
  # secret it needs. Refuse instead, naming the file.
  case "$name" in
    [A-Z_]*) ;;
    *)
      echo "with-credentials: $cred: name must match [A-Z_][A-Z0-9_]*" >&2
      exit 78
      ;;
  esac
  case "$name" in
    *[!A-Z0-9_]*)
      echo "with-credentials: $cred: name must match [A-Z_][A-Z0-9_]*" >&2
      exit 78
      ;;
  esac
  # `export NAME=VALUE` with both sides expanded is POSIX and needs no
  # eval; $name is constrained to [A-Z0-9_] above, and the value is never
  # re-parsed by the shell.
  value=$(cat "$cred")
  export "$name=$value"
done

unset cred name value
exec "$@"
