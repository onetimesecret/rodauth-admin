<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="no-referrer">
  <title>Rodauth Admin</title>
  <style>
    :root { color-scheme: light dark; }
    body { font: 15px/1.5 system-ui, sans-serif; max-width: 64rem; margin: 2rem auto; padding: 0 1rem; }
    header { border-bottom: 2px solid #0d7263; margin-bottom: 1.5rem; padding-bottom: .5rem; display: flex; justify-content: space-between; align-items: baseline; }
    header h1 { font-size: 1.1rem; margin: 0; letter-spacing: .04em; text-transform: uppercase; }
    header nav a { margin-left: 1rem; }
    .flash { padding: .6rem .9rem; border-left: 3px solid; margin-bottom: 1rem; }
    .flash.error { border-color: #b3261e; background: rgba(179,38,30,.08); }
    .flash.notice { border-color: #0d7263; background: rgba(13,114,99,.08); }
    label { display: block; margin-top: .8rem; }
    input[type=text], input[type=email], input[type=password], input[type=search] { width: 100%; padding: .4rem; font: inherit; }
    header nav form { display: inline-block; margin-left: 1rem; }
    header nav form input[type=search] { width: 14rem; padding: .2rem .4rem; }
    header nav form label { display: none; }
    input[type=submit], button { margin-top: 1rem; padding: .5rem 1rem; font: inherit; }
    dl { display: grid; grid-template-columns: max-content 1fr; gap: .3rem 1rem; }
    dt { font-weight: 600; }
    code { font-family: ui-monospace, monospace; }
    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: .8rem; margin: 1rem 0; }
    .stat { border: 1px solid rgba(128,128,128,.35); border-left: 3px solid #0d7263; padding: .6rem .8rem; }
    .stat h3 { font-size: .78rem; margin: 0 0 .3rem; font-weight: 600; text-transform: uppercase; letter-spacing: .03em; opacity: .8; }
    .stat .value { font-size: 1.6rem; line-height: 1.1; font-variant-numeric: tabular-nums; }
    .stat.wide { grid-column: 1 / -1; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
    th, td { text-align: left; padding: .35rem .6rem; border-bottom: 1px solid rgba(128,128,128,.3); vertical-align: top; }
    th { font-size: .78rem; text-transform: uppercase; letter-spacing: .03em; opacity: .8; }
    .stat table { margin: 0; }
    .stat td, .stat th { padding: .15rem .4rem .15rem 0; border: 0; }
    .degraded { border-left: 3px solid #b3261e; background: rgba(179,38,30,.08); padding: .8rem 1rem; margin: 1rem 0; }
    .pagination { display: flex; gap: 1rem; align-items: baseline; margin: 1rem 0; }
    .footnote { font-size: .8rem; opacity: .75; margin: .3rem 0; }
    .filters { margin: 1rem 0; }
    .filters a { margin-right: 1rem; }
    .filters a.current { font-weight: 700; text-decoration: none; }
  </style>
</head>
<body>
  <header>
    <h1>Rodauth Admin</h1>
    <nav>
      <% if rodauth.logged_in? %>
        <a href="/">Stats</a>
        <a href="/accounts?filter=locked">Locked</a>
        <a href="/accounts?filter=orphaned">Orphaned</a>
        <a href="<%= rodauth.logout_path %>">Sign out</a>
        <form method="get" action="/account">
          <label for="nav-q">Email or external id</label>
          <input type="search" id="nav-q" name="q" placeholder="email or external id" aria-label="Email or external id" autocomplete="off">
        </form>
      <% end %>
    </nav>
  </header>
  <% if flash['error'] %><div class="flash error"><%= flash['error'] %></div><% end %>
  <% if flash['notice'] %><div class="flash notice"><%= flash['notice'] %></div><% end %>
  <%== yield %>
</body>
</html>
