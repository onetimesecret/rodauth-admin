

# RACK_ENV is not set here: .envrc owns it (development) and exports it after
# reading this file's copy, so a value here would be ignored. Production sets
# RACK_ENV in the process environment.
ADMIN_DATABASE_URL=
ADMIN_DATABASE_URL_RO=
# The Phase 4 mutation credential (rodauth_admin_verbs). In development this
# can be the same SQLite file as the others; on PostgreSQL it is its own role.
ADMIN_DATABASE_URL_VERBS=
AUTH_SECRET=
ARGON2_SECRET=
RODAUTH_ADMIN_SESSION_SECRET=
RODAUTH_ADMIN_HOST=
COLONEL_CONSOLE_URL=

# Address the process binds to (config/puma.rb). Loopback is the default and
# the ADR-0001 SSH-tunnel deployment; loopback is also what relaxes the session
# cookie's Secure flag so it survives the plain-http tunnel. Set a public
# address only behind real TLS.
#RODAUTH_ADMIN_BIND=127.0.0.1

# The running app should not have the migrations credentials
#ADMIN_DATABASE_URL_MIGRATIONS=
