# .env.example
#
# Rodauth Admin runtime configuration. Copy to .env for local development;
# in production every value below is injected by the deploy, never a file.
#
# Unset RACK_ENV is treated as production everywhere (fail closed).
RACK_ENV=development

# --- database: three credentials, one database -------------------------------
#
# Same pattern as the tenant app's AUTH_DATABASE_URL / _MIGRATIONS split.
# Roles and grants: db/grants/postgres/rodauth_admin_roles.sql.
# Rationale: docs/design/database-credentials.md.
#
# Runtime user. Rodauth writes on every sign-in (login failures, lockouts,
# the auth audit log, the OTP last-use timestamp), and the allowlist and
# admin_actions are written through this connection too.
ADMIN_DATABASE_URL=postgresql://rodauth_admin_app:CHANGE_ME@authdb/onetime_authdb
#
# Read-only user for every admin query. Phase 4 widens it to UPDATE/DELETE
# on token and key tables, and no further.
ADMIN_DATABASE_URL_RO=postgresql://rodauth_admin_ro:CHANGE_ME@authdb/onetime_authdb
#
# The tenant app's EXISTING migration user. Not read by the running app.
# Export it only in the shell that runs `rake db:migrate` (or, locally,
# `rake authdb:dev`).
# ADMIN_DATABASE_URL_MIGRATIONS=postgresql://ots_migrator:CHANGE_ME@authdb/onetime_authdb
#
# Local development default when all three are unset: sqlite://data/authdb.sqlite3

# --- secrets shared with the tenant app (consequence of shared identity) ---
#
# Production OTP keys are stored HMAC'd with the tenant app's AUTH_SECRET and
# password hashes are peppered with its ARGON2_SECRET. The admin door cannot
# verify either without the same values. Rotating them in the tenant app
# means rotating them here in the same change.
AUTH_SECRET=CHANGE_ME_same_value_as_tenant_app
ARGON2_SECRET=CHANGE_ME_same_value_as_tenant_app_or_unset_if_unset_there

# --- the admin's own session cookie ---------------------------------------
#
# >= 64 random bytes. Independent of everything above: rotating it only
# signs every operator out of the admin.
#   ruby -rsecurerandom -e 'puts SecureRandom.hex(64)'
RODAUTH_ADMIN_SESSION_SECRET=CHANGE_ME

# Hostname the admin is served on (Rodauth `domain`). No email links are
# generated here; it is set so the value is deliberate rather than derived
# from a request header.
RODAUTH_ADMIN_HOST=admin.example.internal

# Label shown in authenticator apps when an operator enrols TOTP through
# the admin door (same key lands in the production account_otp_keys row).
OTP_ISSUER=OTS
